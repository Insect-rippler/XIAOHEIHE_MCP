{
  "name": "xiaoheihe-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local capability interface for xiaoheihe.cn: read, search, comment, interact, publish. No prompts, no agent loop.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "probe": "tsx src/index.ts probe",
    "serve": "tsx src/index.ts serve",
    "serve:http": "tsx src/index.ts serve --http",
    "smoke": "node scripts/smoke-mcp.mjs",
    "smoke:http": "node scripts/smoke-http.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.64.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "bin": {
    "xiaoheihe-mcp": "dist/index.js"
  }
}
